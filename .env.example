# ===========================================
#  ORÁCULO DA ALMA — variáveis de ambiente
# ===========================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o arquivo .env para o GitHub.

# Porta onde o servidor vai rodar
PORT=3000

# Segredo usado para assinar os tokens de login (JWT).
# Troque por uma frase longa e aleatória. Exemplo de como gerar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-segredo-bem-longo-e-aleatorio

# Por quanto tempo o login fica válido
JWT_EXPIRES_IN=7d

# Caminho do arquivo do banco de dados SQLite (persistente em disco)
DATABASE_URL=./data/oraculo.db

# ---- Integrações que entram nas próximas etapas ----
# (deixe em branco por enquanto; o sistema roda sem elas)

# Chave da OpenAI — usada SOMENTE pelo backend, nunca exposta ao frontend
OPENAI_API_KEY=coloque_sua_chave_aqui

# Modelo da OpenAI (opcional). Padrão: gpt-4o-mini (mais barato).
# Para respostas mais ricas, use gpt-4o.
OPENAI_MODEL=gpt-4o-mini

# Provedor de PIX (Mercado Pago / Asaas / Gerencianet, etc.)
PIX_PROVIDER_KEY=

# ---- Super Admin (criado automaticamente ao subir o servidor) ----
# Se quiser trocar as credenciais, edite aqui. Caso fique em branco,
# o sistema usa os valores padrão definidos no código.
ADMIN_NAME=Alessandro Valentim
ADMIN_EMAIL=alelimavalent@gmail.com
ADMIN_PASSWORD=Alessandro@2026

# ---- API externa de Astrologia (opcional) ----
# O sistema já calcula tudo localmente. Preencha apenas se for usar um provedor externo.
ASTROLOGY_API_KEY=

# ---- WhatsApp via Evolution API (integração futura) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE=

# ---- Asaas (cobrança PIX) ----
# Produção: https://api.asaas.com/v3  |  Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
